.modal-header
    h4.modal-title {{title}}
    button.btn-close(type='button', aria-label='Close', (click)='close()')

.modal-body
    .text-center.p-4(*ngIf='loading')
        .spinner-border(role='status')

    .alert.alert-danger(*ngIf='error') {{error}}

    ng-container(*ngIf='!loading && !error && revealed')
        .mb-3(*ngIf='kind === "password"')
            label.form-label(translate) Password
            .input-group
                input.form-control(type='text', readonly, [value]='data.password || ""')
                button.btn.btn-secondary(type='button', [disabled]='!data.password', (click)='copy(data.password)')
                    i.fas.fa-copy
            .form-text(*ngIf='!data.password', translate) No saved password

        ng-container(*ngIf='kind === "private-key"')
            .mb-3
                label.form-label(translate) Private key
                textarea.form-control.private-key-content(rows='14', readonly, [value]='data.privateKey || ""')
                button.btn.btn-secondary.mt-2(type='button', [disabled]='!data.privateKey', (click)='copy(data.privateKey)')
                    i.fas.fa-copy.me-2
                    span(translate) Copy

            .mb-3
                label.form-label(translate) Private key passphrase
                .input-group
                    input.form-control(type='text', readonly, [value]='data.passphrase || ""')
                    button.btn.btn-secondary(type='button', [disabled]='!data.passphrase', (click)='copy(data.passphrase)')
                        i.fas.fa-copy
                .form-text(*ngIf='!data.passphrase', translate) No saved passphrase

    .text-center.p-4(*ngIf='!loading && !error && !revealed')
        button.btn.btn-primary(type='button', (click)='reveal()')
            i.fas.fa-eye.me-2
            span(translate) Show again

.modal-footer
    button.btn.btn-secondary(type='button', *ngIf='revealed', (click)='hide()')
        i.fas.fa-eye-slash.me-2
        span(translate) Hide
    button.btn.btn-primary(type='button', (click)='close()', translate) Close
